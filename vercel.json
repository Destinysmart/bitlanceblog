{
  "redirects": [
    { "source": "/", "destination": "https://www.bitlance.work/blog", "permanent": true },
    { "source": "/article/:slug", "destination": "https://www.bitlance.work/blog/article/:slug", "permanent": true },
    { "source": "/category/:slug", "destination": "https://www.bitlance.work/blog", "permanent": true },
    { "source": "/topic/:slug", "destination": "https://www.bitlance.work/blog", "permanent": true },
    { "source": "/featured/:slug", "destination": "https://www.bitlance.work/blog", "permanent": true },
    { "source": "/signup", "destination": "https://www.bitlance.work/signup", "permanent": true },
    { "source": "/profile", "destination": "https://www.bitlance.work/blog", "permanent": true },
    { "source": "/sitemap.xml", "destination": "https://www.bitlance.work/sitemap.xml", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
